{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deplug",
  "version": "0.1.1",
  "identifier": "com.ivane.deplug",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deplug",
        "width": 1280,
        "height": 720,
        "center": true,
        "decorations": true,
        "resizable": true,
        "minHeight": 720,
        "minWidth": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "publisher": "Ivan Erricis",
    "copyright": "Copyright (c) 2026 Ivan Erricis. All rights reserved.",
    "shortDescription": "Find and remove audio plugins",
    "longDescription": "Deplug finds the VST2, VST3, AAX, AU and CLAP plugins installed on your computer and uninstalls the ones you choose."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRUY2QjQyNEY5NDg4RTQKUldUa2lKUlBRbXZ2LzVFOE5idThNOFIrSTFadDFZVWF6VERIVnN0b3pFbUpnYlYvcjFKQ3MvMEMK",
      "endpoints": [
        "https://github.com/ivanerricis/deplug/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
